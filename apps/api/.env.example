# Copy to .env (Local) and .env.production (Production): same keys. Blocks by
# owner, keys in alphabetical order.

# API
API_CORS_ORIGINS="http://localhost:3200,http://localhost:3400"
API_ENABLE_DOCS="false"
# fatal | error | warn | info | debug | trace
API_LOG_LEVEL="debug"
API_RATE_LIMIT_MAX="100"
API_RATE_LIMIT_WINDOW_MS="60000"
# The trailing /0 is the Redis database index.
API_REDIS_URL="redis://localhost:6379/0"
# Reverse-proxy hops in front: 0 locally, 1 behind Traefik.
API_TRUSTED_PROXY_HOPS="0"
PORT="3300"

# Auth (AUTH_SECRET: `openssl rand -base64 32`)
# Production only: the parent domain every App shares Session cookies on.
# AUTH_COOKIE_DOMAIN=".isaiariva.com"
AUTH_RATE_LIMIT_KEY_PREFIX="auth:"
AUTH_RATE_LIMIT_MAX="10"
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3300"

# Database
DATABASE_URL="postgresql://allonfire:allonfire@localhost:5432/allonfire"

# Storage (Local MinIO and image server, throwaway key and salt)
STORAGE_ACCESS_KEY="allonfire"
# STORAGE_BUCKET="image"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_IMAGE_SERVER_KEY="5ac692d6a2b19f10fdcdc2f2dd03efdf413a4108bf93d08508e9c4c6656d95f1"
STORAGE_IMAGE_SERVER_SALT="b8d9db70864d2cf60e0b5d06d04b8cb5"
STORAGE_IMAGE_SERVER_URL="http://localhost:9010/image"
STORAGE_SECRET_KEY="allonfire"

# Telemetry: no endpoint, no telemetry. The header is Basic auth with the space
# as %20; Local OpenObserve (http://localhost:5080) is
# allonfire@allonfire.local / Allonfire#1.
TELEMETRY_ENDPOINT="http://localhost:5080/api/default"
TELEMETRY_HEADERS="Authorization=Basic%20YWxsb25maXJlQGFsbG9uZmlyZS5sb2NhbDpBbGxvbmZpcmUjMQ=="
TELEMETRY_SERVICE_NAME="allonfire-api"
