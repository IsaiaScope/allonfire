{
  "name": "@allonfire/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/app.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "i18n:check": "i18n-check --locales src/features/i18n/translations --source en",
    "predev": "docker compose -f ../../docker/docker-compose.dev.yml up -d redis",
    "test": "vitest run"
  },
  "dependencies": {
    "@allonfire/database": "workspace:*",
    "@allonfire/utils": "workspace:*",
    "@formatjs/fast-memoize": "^3.1.7",
    "@formatjs/intl-localematcher": "^0.8.13",
    "@hono/node-server": "^1.14.0",
    "@hono/standard-validator": "^0.2.0",
    "@scalar/hono-api-reference": "^0.9.0",
    "@t3-oss/env-core": "^0.13.10",
    "hono": "^4.9.0",
    "hono-openapi": "^1.1.0",
    "hono-pino": "^0.10.0",
    "hono-rate-limiter": "^0.5.3",
    "intl-messageformat": "^11.2.14",
    "ioredis": "^5.6.0",
    "negotiator": "^1.1.0",
    "pino": "^9.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@allonfire/config": "workspace:*",
    "@lingual/i18n-check": "^0.9.5",
    "@types/negotiator": "^0.6.5",
    "http-status-codes": "^2.3.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.0"
  }
}
