{
  "name": "@allonfire/back-office",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "find .next -name '._*' -delete 2>/dev/null; next build",
    "check-types": "next typegen && tsc --noEmit",
    "dev": "find .next -name '._*' -delete 2>/dev/null; next dev --port 3400",
    "i18n:check": "i18n-check --locales src/features/i18n/translations --source en",
    "start": "next start --port 3400",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@allonfire/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@allonfire/config": "workspace:*",
    "@lingual/i18n-check": "^0.9.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
