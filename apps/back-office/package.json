{
  "name": "@allonfire/back-office",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "find .next -name '._*' -delete 2>/dev/null; next build",
    "check-types": "STORAGE_ENDPOINT=${STORAGE_ENDPOINT:-http://localhost:9000} next typegen && tsc --noEmit",
    "dev": "find .next -name '._*' -delete 2>/dev/null; next dev --port 3400",
    "i18n:check": "i18n-check --locales src/features/i18n/translations --source en",
    "start": "next start --port 3400",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:headed": "vitest run --config vitest.browser.config.ts --browser.headless=false",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@allonfire/api": "workspace:*",
    "@allonfire/auth": "workspace:*",
    "@allonfire/core": "workspace:*",
    "@allonfire/database": "workspace:*",
    "@allonfire/design": "workspace:*",
    "@allonfire/storage": "workspace:*",
    "@allonfire/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "hono": "^4.9.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@allonfire/config": "workspace:*",
    "@lingual/i18n-check": "^0.9.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "msw": "^2.15.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
