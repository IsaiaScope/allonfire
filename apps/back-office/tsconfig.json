{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": [
      "node",
      "vitest/globals",
      "@allonfire/config/tests/browser/asset-url"
    ]
  },
  "include": [
    "src",
    "e2e",
    "next.config.ts",
    "next-env.d.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "vitest.browser.setup.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
