# Copy to .env.development (Local) and env/.env.production (Production; not the
# App's root, where `next build` would load it): same keys. Blocks by owner,
# keys in alphabetical order. Tailscale: the tailnet address as BACK_OFFICE_URL
# in .env.development.local.

# API (NEXT_PUBLIC_API_URL is the browser's, baked in at build)
API_AUTH_URL="http://localhost:3300/v1/auth"
API_URL="http://localhost:3300"
NEXT_PUBLIC_API_URL="http://localhost:3300"

# Auth
AUTH_APP="BACK_OFFICE"
# Production only: the parent domain every App shares Session cookies on.
# AUTH_COOKIE_DOMAIN=".isaiariva.com"

# Back Office: its own address; build and runtime must match.
BACK_OFFICE_URL="http://localhost:3400"

# Laura (unset: the App switcher leaves it out)
LAURA_URL="http://localhost:3200"
