# Copy to .env.development (gitignored) for `next dev`.

# The API from the browser (public, baked in at build).
NEXT_PUBLIC_API_URL="http://localhost:3300"

# Better Auth on the API from this App's server, path included (the API mounts
# it under /v1). Production: the internal Docker address.
API_AUTH_URL="http://localhost:3300/v1/auth"
# The parent domain the API sets the Session cookies for, the same value as the
# API's AUTH_COOKIE_DOMAIN. Unset locally: everything is localhost.
# AUTH_COOKIE_DOMAIN=".isaiariva.com"

# Which App this is, for the shared auth; its floor and Registration live in ACCESS.APP_SETTINGS.
AUTH_APP="BACK_OFFICE"

# MinIO for the /storage/images rewrite, read at build.
STORAGE_ENDPOINT="http://localhost:9000"
# The Images' bucket, read at build; an e2e run builds against its own.
# STORAGE_BUCKET="image"
