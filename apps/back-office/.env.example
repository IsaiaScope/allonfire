# Copy to .env.development (gitignored) for `next dev`.

# The API from this App's server (production: the internal Docker address)
# and from the browser (public, baked in at build).
API_URL="http://localhost:3300"
NEXT_PUBLIC_API_URL="http://localhost:3300"

# Better Auth on the API, path included (the API mounts it under /v1).
API_AUTH_URL="http://localhost:3300/v1/auth"

# Which App this is and the lowest Role it lets in, for the shared auth.
AUTH_APP="BACK_OFFICE"
AUTH_MIN_ROLE="ADMIN"

# MinIO for the /storage/images rewrite, read at build.
STORAGE_ENDPOINT="http://localhost:9000"
