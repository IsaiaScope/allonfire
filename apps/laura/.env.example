# Every name here comes from a zod schema — apps/laura/src/env.ts composes
# @allonfire/database, @allonfire/auth and @allonfire/storage. A missing
# required key fails the build, not the request.

# @allonfire/database — shares the database with apps/api.
DATABASE_URL="postgresql://allonfire:allonfire@localhost:5432/allonfire"

# @allonfire/auth — BETTER_AUTH_SECRET signs sessions, generate your own.
BETTER_AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3200"

# @allonfire/storage — MinIO holds uploaded photos. `pnpm docker:up` starts it.
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="laura-photos"

# Optional. Both must be set for the login page to offer viewer quick-login;
# with either missing the block is skipped silently. Note the LAURA_ prefix —
# the schema reads LAURA_VIEWER_EMAIL, not VIEWER_EMAIL.
LAURA_VIEWER_EMAIL="laura-viewer@allonfire.com"
LAURA_VIEWER_PASSWORD="viewer1234"
