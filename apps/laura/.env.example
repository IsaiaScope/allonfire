# Copy to .env (Local). Every key comes from apps/laura/src/env.ts. Blocks by
# owner, keys in alphabetical order.

# Auth (BETTER_AUTH_SECRET: `openssl rand -base64 32`)
BETTER_AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3200"

# Database
DATABASE_URL="postgresql://allonfire:allonfire@localhost:5432/allonfire"

# Laura: viewer quick-login on the login page, both or it is hidden
LAURA_VIEWER_EMAIL="laura-viewer@allonfire.com"
LAURA_VIEWER_PASSWORD="viewer1234"

# Storage (Local MinIO)
MINIO_ACCESS_KEY="minioadmin"
MINIO_BUCKET="laura-photos"
MINIO_ENDPOINT="http://localhost:9000"
MINIO_SECRET_KEY="minioadmin"
