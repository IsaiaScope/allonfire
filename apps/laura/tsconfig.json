{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@allonfire/hooks/*": ["../../packages/hooks/src/*"],
      "@allonfire/ui/*": ["../../packages/ui/src/*"],
      "@allonfire/database": ["../../packages/database/src/index.ts"],
      "@allonfire/storage": ["../../packages/storage/src/index.ts"],
      "@allonfire/storage/*": ["../../packages/storage/src/*"],
      "@allonfire/auth/*": ["../../packages/auth/src/*"],
      "@allonfire/utils/*": ["../../packages/utils/src/*"]
    },
    "allowJs": true
  },
  "include": [
    "src",
    "scripts",
    "next.config.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
