# Root env — read by docker compose when it interpolates ${VAR} in docker/*.yml.
# Per-app secrets live in that app's own .env (see apps/*/.env.example).

# Postgres container credentials. The compose files default to "allonfire" for
# all three, so these only matter if you want something else locally.
POSTGRES_USER="allonfire"
POSTGRES_PASSWORD="allonfire"
POSTGRES_DB="allonfire"
