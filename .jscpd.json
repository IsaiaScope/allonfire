{
  "path": ["apps/api", "apps/back-office", "packages", ".github", "docker"],
  "format": ["typescript", "tsx", "javascript", "yaml"],
  "minTokens": 60,
  "minLines": 6,
  "absolute": true,
  "exitCode": 1,
  "reporters": ["console", "json"],
  "output": ".jscpd",
  "gitignore": true,
  "ignore": [
    "**/._*",
    "**/node_modules/**",
    "**/.next/**",
    "packages/auth-old/**",
    "packages/ui-old/**",
    "packages/shadcn/**",
    "**/generated/**",
    "**/*.d.ts"
  ]
}
