{
  "path": [
    "apps/api",
    "apps/back-office",
    "apps/laura",
    "packages",
    ".github",
    "docker"
  ],
  "format": ["typescript", "tsx", "javascript", "yaml"],
  "minTokens": 60,
  "minLines": 6,
  "absolute": true,
  "exitCode": 1,
  "reporters": ["console", "json"],
  "output": ".jscpd",
  "gitignore": true,
  "ignore": [
    "**/._*",
    "**/node_modules/**",
    "**/.next/**",
    "packages/shadcn/**",
    "**/generated/**",
    "**/*.d.ts"
  ]
}
