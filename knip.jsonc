{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // How to read a hit and when to accept one: docs/guides/tooling.md. Every
  // ignore entry sits under a `//` reason (a run of entries shares the one
  // above it) and none covers a whole folder:
  // packages/config/local/tests/knip-config.test.ts.
  //
  // `!` marks production. `pnpm knip:production` starts only from `!` entries
  // and what knip finds itself (Next pages, package exports, `start`
  // scripts), over each `project` minus its `!…!` negations: tests, test
  // helpers, Vitest setup and e2e. `pnpm knip` reads everything.
  "includeEntryExports": true,
  "ignoreBinaries": [
    // `pnpm dev:tailscale` runs the Tailscale CLI installed on the machine,
    // not an npm package.
    "tailscale",
    // Package scripts run in their package (`pnpm -C packages/storage
    // test-bucket`, `pnpm -C packages/database test-database`), which knip
    // reads as binaries.
    "test-bucket",
    "test-database"
  ],
  "ignoreIssues": {
    // A type test's exports exist only for tsc to check; nothing imports them.
    "**/*.test-d.{ts,tsx}": ["exports", "types"],
    // Generated by the shadcn CLI, kept so any can be wrapped without
    // re-adding.
    "packages/shadcn/src/components/GooeyNav.tsx": ["exports", "types"],
    "packages/shadcn/src/components/accordion.tsx": ["exports"],
    "packages/shadcn/src/components/action-bar.tsx": ["exports", "types"],
    "packages/shadcn/src/components/alert-dialog.tsx": ["exports"],
    "packages/shadcn/src/components/alert.tsx": ["exports"],
    "packages/shadcn/src/components/aspect-ratio.tsx": ["exports"],
    "packages/shadcn/src/components/attachment.tsx": ["exports"],
    "packages/shadcn/src/components/avatar.tsx": ["exports"],
    "packages/shadcn/src/components/badge.tsx": ["exports"],
    "packages/shadcn/src/components/breadcrumb.tsx": ["exports"],
    "packages/shadcn/src/components/bubble.tsx": ["exports"],
    "packages/shadcn/src/components/button-group.tsx": ["exports"],
    "packages/shadcn/src/components/calendar.tsx": ["exports"],
    "packages/shadcn/src/components/card.tsx": ["exports"],
    "packages/shadcn/src/components/carousel.tsx": ["exports", "types"],
    "packages/shadcn/src/components/chart.tsx": ["exports", "types"],
    "packages/shadcn/src/components/collapsible.tsx": ["exports"],
    "packages/shadcn/src/components/combobox.tsx": ["exports"],
    "packages/shadcn/src/components/command.tsx": ["exports"],
    "packages/shadcn/src/components/context-menu.tsx": ["exports"],
    "packages/shadcn/src/components/cropper.tsx": ["exports", "types"],
    "packages/shadcn/src/components/dialog.tsx": ["exports"],
    "packages/shadcn/src/components/direction.tsx": ["exports"],
    "packages/shadcn/src/components/drawer.tsx": ["exports"],
    "packages/shadcn/src/components/dropdown-menu.tsx": ["exports"],
    "packages/shadcn/src/components/empty.tsx": ["exports"],
    "packages/shadcn/src/components/faceted.tsx": ["exports"],
    "packages/shadcn/src/components/field.tsx": ["exports"],
    "packages/shadcn/src/components/file-upload.tsx": ["exports", "types"],
    "packages/shadcn/src/components/hover-card.tsx": ["exports"],
    "packages/shadcn/src/components/input-group.tsx": ["exports"],
    "packages/shadcn/src/components/input-otp.tsx": ["exports"],
    "packages/shadcn/src/components/item.tsx": ["exports"],
    "packages/shadcn/src/components/kbd.tsx": ["exports"],
    "packages/shadcn/src/components/marker.tsx": ["exports"],
    "packages/shadcn/src/components/menubar.tsx": ["exports"],
    "packages/shadcn/src/components/message-scroller.tsx": ["exports"],
    "packages/shadcn/src/components/message.tsx": ["exports"],
    "packages/shadcn/src/components/native-select.tsx": ["exports"],
    "packages/shadcn/src/components/navigation-menu.tsx": ["exports"],
    "packages/shadcn/src/components/pagination.tsx": ["exports"],
    "packages/shadcn/src/components/popover.tsx": ["exports"],
    "packages/shadcn/src/components/progress.tsx": ["exports"],
    "packages/shadcn/src/components/questionnaire.tsx": ["exports"],
    "packages/shadcn/src/components/radio-group.tsx": ["exports"],
    "packages/shadcn/src/components/resizable.tsx": ["exports"],
    "packages/shadcn/src/components/scroll-area.tsx": ["exports"],
    "packages/shadcn/src/components/select.tsx": ["exports"],
    "packages/shadcn/src/components/sheet.tsx": ["exports"],
    "packages/shadcn/src/components/sidebar.tsx": ["exports"],
    "packages/shadcn/src/components/slider.tsx": ["exports"],
    "packages/shadcn/src/components/spinner.tsx": ["exports"],
    "packages/shadcn/src/components/switch.tsx": ["exports"],
    "packages/shadcn/src/components/table.tsx": ["exports"],
    "packages/shadcn/src/components/tabs.tsx": ["exports"],
    "packages/shadcn/src/components/toast.tsx": ["exports"],
    "packages/shadcn/src/components/toggle-group.tsx": ["exports"],
    "packages/shadcn/src/components/toggle.tsx": ["exports"],
    "packages/shadcn/src/components/tooltip.tsx": ["exports"],
    // Declarations beside a shadcn component (shadcn's `vendor:types`),
    // mirroring its exports.
    "packages/shadcn/src/components/GooeyNav.d.ts": ["exports", "types"],
    "packages/shadcn/src/components/calendar.d.ts": ["exports"],
    "packages/shadcn/src/components/faceted.d.ts": ["exports"],
    "packages/shadcn/src/components/scroll-area.d.ts": ["exports"],
    "packages/shadcn/src/components/sonner.d.ts": ["exports"],
    // Held only by Laura, which sits outside the workspace.
    "packages/core/src/features/errors/format-error-message.ts": ["exports"],
    "packages/database/src/features/apps/laura/game-score.service.ts": [
      "exports",
      "types"
    ],
    // Held only by Laura (`playwrightConfig`); `aofPlaywrightConfig` is read
    // by the Apps' playwright.config.ts, which production mode leaves out.
    "packages/config/tests/e2e/playwright.config.ts": ["exports"],
    // Kept for the Images page.
    "packages/ui/src/components/aof-image.tsx": ["exports", "types"],
    // Read by the Apps' next.config.ts, which production mode leaves out.
    "packages/auth/src/features/next/utils/with-provider-pictures.ts": [
      "exports"
    ],
    "packages/core/src/features/next/config/utils/aof-create-next-config.ts": [
      "exports"
    ],
    "packages/core/src/features/next/config/utils/aof-with-localized-not-found.ts": [
      "exports"
    ],
    // Test helpers and test setup other packages' tests import, through
    // export keys; production mode leaves every test out.
    "packages/auth/src/features/users/hono/tests/stub-user-deps.ts": [
      "exports"
    ],
    "packages/auth/src/shared/tests/stub-auth.ts": ["exports"],
    "packages/auth/src/shared/tests/test-host.ts": ["exports"],
    "packages/config/tests/browser/msw.ts": ["exports"],
    "packages/config/tests/browser/vitest.browser.config.ts": ["exports"],
    "packages/database/src/features/test-database/utils/local-env.ts": [
      "exports"
    ],
    "packages/storage/src/features/image/hono/tests/stub-image-deps.ts": [
      "exports"
    ],
    // watchRedis is unit-tested; awaitReady is the wait apps/api/README.md
    // asks of any command issued at startup, and only integration tests
    // issue one yet.
    "apps/api/src/features/redis/redis.ts": ["exports"],
    // The Hono guard a host mounts to keep routes to an App's members
    // (packages/auth/README.md); no API route mounts it yet, its tests do.
    "packages/auth/src/features/hono/guards/middleware/require-app.ts": [
      "exports"
    ],
    // For an indexed App's pages (alternates, sitemap); no App is indexed yet,
    // so only its test reads them.
    "packages/core/src/features/next/metadata/utils/aof-indexed.ts": [
      "exports"
    ],
    // Mounted by hand while debugging the query cache (the Back Office
    // layout's comment says where).
    "packages/core/src/features/next/providers/components/aof-react-query-devtools.tsx": [
      "exports"
    ]
  },
  "workspaces": {
    ".": {
      "project": ["*.{js,ts}"]
    },
    "apps/api": {
      "entry": ["src/**/*.test-d.ts", "src/index.ts!"],
      "project": [
        "**/*.{js,ts,tsx}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    },
    "apps/back-office": {
      "project": [
        "**/*.{js,ts,tsx,css}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!",
        "!e2e/**!"
      ]
    },
    "packages/*": {
      "project": [
        "**/*.{js,ts,tsx}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    },
    "packages/auth": {
      "entry": ["src/**/*.test-d.ts"],
      "project": [
        "**/*.{js,ts,tsx}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    },
    "packages/config": {
      "ignoreUnresolved": [
        // typescript/nextjs.json names Next's TypeScript plugin, which each
        // Next App installs; config itself has no `next`.
        "next"
      ],
      "project": [
        "**/*.{js,ts,tsx}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    },
    "packages/core": {
      "entry": [
        "src/**/*.test-d.ts",
        "src/features/ci/print-affected.ts!",
        "src/features/next/pwa/utils/cli.ts!",
        "src/features/tailwind/canonicalize.ts!",
        "src/features/typescript/vendor-types.ts!"
      ],
      "ignoreDependencies": [
        // core's createLogger names pino's OpenTelemetry transport as a
        // string target, which pino loads in a worker: no import shows it.
        "pino-opentelemetry-transport",
        // core's createLogger names pino-pretty as a string target, for the
        // API's dev logs only.
        "pino-pretty"
      ],
      "project": [
        "**/*.{js,ts,tsx}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    },
    "packages/database": {
      "entry": [
        "src/features/seed/utils/cli.ts!",
        "src/features/test-database/utils/cli.ts!",
        "scripts/changeset.ts!"
      ],
      "project": [
        "**/*.{js,ts,tsx,prisma}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    },
    "packages/design": {
      "entry": ["scripts/sync.ts!"],
      "project": [
        "**/*.{js,ts,tsx}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    },
    "packages/shadcn": {
      "ignoreDependencies": [
        // tsconfig.json extends config's TypeScript preset by a relative path,
        // which knip does not read as a use.
        "@allonfire/config"
      ],
      "project": [
        "**/*.{js,ts,tsx,css}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    },
    "packages/storage": {
      "entry": [
        "src/**/*.test-d.ts",
        "src/features/image/setup/utils/cli.ts!",
        "src/features/test-bucket/utils/cli.ts!",
        "src/features/image/fixtures/scripts/describe-fixtures.ts!"
      ],
      "project": [
        "**/*.{js,ts,tsx}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    },
    "packages/ui": {
      "entry": ["src/**/*.test-d.{ts,tsx}"],
      "project": [
        "**/*.{js,ts,tsx}!",
        "!**/tests/**!",
        "!**/*.test*.{ts,tsx}!",
        "!vitest.*.ts!"
      ]
    }
  }
}
