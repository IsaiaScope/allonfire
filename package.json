{
  "name": "allonfire",
  "version": "0.6.6",
  "private": true,
  "description": "Turborepo monorepo of Next.js apps on one Hono API, with shared packages for auth, database, storage and design",
  "homepage": "https://github.com/IsaiaScope/allonfire#readme",
  "bugs": {
    "url": "https://github.com/IsaiaScope/allonfire/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IsaiaScope/allonfire.git"
  },
  "license": "MIT",
  "author": "Isaia Riva <40738274+IsaiaScope@users.noreply.github.com>",
  "scripts": {
    "build": "tsx packages/config/stages/scripts/stage.ts build",
    "build:apps": "turbo run build",
    "check": "tsx packages/config/stages/scripts/stage.ts check",
    "ci:affected": "pnpm --filter @allonfire/core exec tsx src/features/ci/print-affected.ts",
    "db:changeset": "pnpm --filter @allonfire/database db:changeset",
    "db:drift": "pnpm --filter @allonfire/database db:drift",
    "db:generate": "pnpm --filter @allonfire/database db:generate",
    "db:rollback": "pnpm --filter @allonfire/database db:rollback",
    "db:seed": "pnpm --filter @allonfire/database db:seed",
    "db:status": "pnpm --filter @allonfire/database db:status",
    "db:update": "pnpm --filter @allonfire/database db:update",
    "design:sync": "pnpm --filter @allonfire/design design:sync",
    "dev": "pnpm docker:up && { pnpm -s dev:tailscale || echo \"Tailscale is off: the Apps answer on localhost only\"; } && trap \"pnpm -s dev:tailscale:off >/dev/null 2>&1\" EXIT INT TERM && turbo run dev test //#test:ui --continue --ui=tui",
    "dev:setup": "pnpm docker:up && pnpm db:generate && pnpm db:update && pnpm db:seed && pnpm --filter @allonfire/storage image:setup",
    "dev:tailscale": "tailscale serve --service=svc:back-office --https=443 http://localhost:3400 && tailscale serve --service=svc:laura --https=443 http://localhost:3200 && tailscale serve --service=svc:cdn --https=443 http://localhost:9010 && tailscale serve status",
    "dev:tailscale:off": "tailscale serve reset",
    "docker:build:laura": "docker build --build-arg APP_NAME=laura -f docker/Dockerfile -t allonfire-laura .",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "e2e": "tsx packages/config/stages/scripts/stage.ts e2e",
    "e2e:browser": "turbo run test:browser",
    "e2e:browser:headed": "pnpm -r --workspace-concurrency=1 run test:browser:headed",
    "e2e:headed": "pnpm -r --workspace-concurrency=1 run test:e2e:headed",
    "e2e:run": "turbo run test:e2e",
    "e2e:ui": "pnpm -r --workspace-concurrency=1 run test:e2e:ui",
    "env:prod": "bash packages/config/local/env-production.sh",
    "prepare": "husky",
    "static": "tsx packages/config/stages/scripts/stage.ts static",
    "static:design": "pnpm design:sync --check",
    "static:dupes": "jscpd",
    "static:fix": "ultracite fix && pnpm --filter @allonfire/back-office tailwind:fix",
    "static:i18n": "turbo run i18n:check",
    "static:knip": "knip",
    "static:knip-production": "knip --production",
    "static:lint": "ultracite check --error-on-warnings && oxlint --type-aware",
    "static:migrate-image": "docker build --check -f packages/database/liquibase/Dockerfile .",
    "static:shell": "shellcheck -x packages/database/liquibase/*.sh packages/database/scripts/*.sh",
    "static:tailwind": "turbo run tailwind:check",
    "static:types": "turbo run check-types",
    "static:workflows": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.7 -color .github/workflows/[!.]*.yml",
    "test": "tsx packages/config/stages/scripts/stage.ts test",
    "test:coverage": "vitest run --coverage",
    "test:drift": "DATABASE_URL=\"$(pnpm -s -C packages/database test-database template)\" pnpm db:drift",
    "test:integration": "vitest run --tags-filter=integration",
    "test:run": "turbo run test",
    "test:services": "docker compose -f docker/docker-compose.dev.yml up -d --wait database redis storage image-server cdn",
    "test:ui": "vitest --ui --watch --standalone --coverage --open=false",
    "test:unit": "vitest run --tags-filter=unit"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-case": [
        2,
        "always",
        [
          "lower-case",
          "upper-case"
        ]
      ],
      "scope-empty": [
        2,
        "never"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "pnpm --filter @allonfire/back-office tailwind:canonicalize",
      "biome check --write --no-errors-on-unmatched --error-on-warnings --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.11",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "lint-staged": "^16.0.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsx": "^4.19.0",
    "turbo": "2.11.7",
    "typescript": "~6.0.3",
    "ultracite": "7.12.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "24.21.0"
  }
}
