{
  "name": "allonfire",
  "version": "0.5.0",
  "private": true,
  "description": "Turborepo monorepo of Next.js apps on one Hono API, with shared packages for auth, database, storage and design",
  "homepage": "https://github.com/IsaiaScope/allonfire#readme",
  "bugs": {
    "url": "https://github.com/IsaiaScope/allonfire/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IsaiaScope/allonfire.git"
  },
  "license": "MIT",
  "author": "Isaia Riva <40738274+IsaiaScope@users.noreply.github.com>",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "ci:affected": "pnpm --filter @allonfire/core exec tsx src/features/ci/print-affected.ts",
    "db:changeset": "pnpm --filter @allonfire/database db:changeset",
    "db:drift": "pnpm --filter @allonfire/database db:drift",
    "db:generate": "pnpm --filter @allonfire/database db:generate",
    "db:rollback": "pnpm --filter @allonfire/database db:rollback",
    "db:seed": "pnpm --filter @allonfire/database db:seed",
    "db:status": "pnpm --filter @allonfire/database db:status",
    "db:update": "pnpm --filter @allonfire/database db:update",
    "design:sync": "pnpm --filter @allonfire/design design:sync",
    "dev": "pnpm docker:up && { pnpm -s dev:tailscale || echo \"Tailscale is off: the Apps answer on localhost only\"; } && trap \"pnpm -s dev:tailscale:off >/dev/null 2>&1\" EXIT INT TERM && turbo run dev test //#test:ui --continue --ui=tui",
    "dev:setup": "pnpm docker:up && pnpm db:generate && pnpm db:update && pnpm db:seed && pnpm --filter @allonfire/storage image:setup",
    "dev:tailscale": "tailscale serve --service=svc:back-office --https=443 http://localhost:3400 && tailscale serve --service=svc:laura --https=443 http://localhost:3200 && tailscale serve --service=svc:image-server --https=443 http://localhost:9010 && tailscale serve status",
    "dev:tailscale:off": "tailscale serve reset",
    "docker:build:laura": "docker build --build-arg APP_NAME=laura -f docker/Dockerfile -t allonfire-laura .",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dupes": "jscpd",
    "i18n:check": "turbo run i18n:check",
    "knip": "knip",
    "lint": "ultracite check --error-on-warnings && oxlint --type-aware",
    "lint:fix": "ultracite fix",
    "prepare": "husky",
    "tailwind:check": "turbo run tailwind:check",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:browser:headed": "pnpm -r --workspace-concurrency=1 run test:browser:headed",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:headed": "pnpm -r --workspace-concurrency=1 run test:e2e:headed",
    "test:e2e:ui": "pnpm -r --workspace-concurrency=1 run test:e2e:ui",
    "test:integration": "vitest run --tags-filter=integration",
    "test:ui": "vitest --ui --watch --standalone --coverage --open=false",
    "test:unit": "vitest run --tags-filter=unit"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-case": [
        2,
        "always",
        [
          "lower-case",
          "upper-case"
        ]
      ],
      "scope-empty": [
        2,
        "never"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "pnpm --filter @allonfire/back-office tailwind:canonicalize",
      "biome check --write --no-errors-on-unmatched --error-on-warnings --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.11",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "lint-staged": "^16.0.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "ultracite": "7.12.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "24.21.0"
  }
}
