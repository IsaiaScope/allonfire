{
  "name": "allonfire",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.1.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "pre-commit": "pnpm lint && pnpm check-types && lint-staged --allow-empty",
    "commit-msg": "npx --no -- commitlint --edit",
    "prepare": "husky",
    "db:push": "pnpm --filter @allonfire/database db:push",
    "db:generate": "pnpm --filter @allonfire/database db:generate",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:test": "docker compose -f docker/docker-compose.test.yml up --build",
    "docker:test:down": "docker compose -f docker/docker-compose.test.yml down",
    "n8n:import": "sh docker/import-n8n-workflows.sh",
    "dev:setup": "pnpm docker:up && pnpm db:generate && pnpm db:push && pnpm db:seed && pnpm n8n:import",
    "dev:full": "pnpm dev:setup && pnpm dev",
    "db:seed": "pnpm --filter @allonfire/database db:seed",
    "docker:build:social": "docker build --build-arg APP_NAME=social -f docker/Dockerfile -t allonfire-social .",
    "docker:build:all": "pnpm docker:build:social",
    "docker:prod:up": "docker compose -f docker/docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker/docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker/docker-compose.prod.yml logs -f",
    "docker:deploy:social": "pnpm docker:build:social && docker compose -f docker/docker-compose.prod.yml up -d social",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^22.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "turbo": "^2.5.3",
    "typescript": "~5.8.2",
    "ultracite": "7.2.4"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-case": [
        2,
        "always",
        [
          "lower-case",
          "upper-case"
        ]
      ],
      "scope-empty": [
        2,
        "never"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "*.json": [
      "biome format --write"
    ]
  },
  "volta": {
    "node": "22.14.0"
  }
}
