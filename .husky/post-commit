#!/bin/sh
# Detect graphify python interpreter - stored path first, then system python3
if [ -f graphify-out/.graphify_python ] && "$(cat graphify-out/.graphify_python)" -c "import graphify" >/dev/null 2>&1; then
  PYTHON=$(cat graphify-out/.graphify_python)
elif python3 -c "import graphify" >/dev/null 2>&1; then
  PYTHON=python3
else
  exit 0
fi

"$PYTHON" -m graphify . --update &
