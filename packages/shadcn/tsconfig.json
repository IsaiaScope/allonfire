{
  "extends": "../config/typescript/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "ES2022"],
    // Vendor code, never edited (ADR 0010). The generated components break
    // these two strict flags (calendar.tsx, scroll-area.tsx on shadcn 4.21).
    // TypeScript checks the .tsx source under each importer's config, so every
    // consumer (packages/ui, apps/back-office) relaxes them too;
    // packages/ui's shadcn-compat test fails if one stops.
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false,
    "paths": {
      "@allonfire/shadcn/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": ["src"],
  // Vendor files not written for strict TypeScript, checked instead by the
  // lenient src/components/tsconfig.json, which lists the same files. Their
  // importers read each one's generated .d.ts (`pnpm vendor:types`, the
  // `types` condition of the components export) and stay strict. A guard test
  // (packages/ui shadcn-compat) fails when the two lists drift.
  "exclude": ["src/components/GooeyNav.tsx"]
}
