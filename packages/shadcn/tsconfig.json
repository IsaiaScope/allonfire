{
  "extends": "../config/typescript/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "ES2022"],
    // Vendor code, never edited (ADR 0010). The generated components break
    // these two strict flags, so this package's own check relaxes them. Its
    // importers stay strict: TypeScript checks an imported .tsx under the
    // importer's config, so a component that breaks them is reached through
    // its generated .d.ts instead (the "exclude" below).
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false,
    "paths": {
      "@allonfire/shadcn/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": ["src"],
  // Vendor files that break the strict rules, checked instead by the lenient
  // tsconfigs beside them (src/components/tsconfig.json: not strict at all;
  // tsconfig.relaxed.json: strict but for the two flags), which list the same
  // files. Their importers read each one's generated .d.ts (`pnpm
  // vendor:types`, the `types` condition of the components export) and stay
  // strict. A guard test (packages/ui shadcn-compat) fails when the lists drift.
  "exclude": [
    "src/components/GooeyNav.tsx",
    "src/components/calendar.tsx",
    "src/components/faceted.tsx",
    "src/components/scroll-area.tsx",
    "src/components/sonner.tsx"
  ]
}
