{
  "name": "@allonfire/shadcn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": {
      "types": "./src/components/*.d.ts",
      "default": "./src/components/*.tsx"
    },
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "canonicalize": "pnpm --filter @allonfire/core tailwind:canonicalize --css packages/shadcn/src/styles/globals.css --dir packages/shadcn/src/components --dir packages/shadcn/src/hooks --dir packages/shadcn/src/lib",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/components/tsconfig.json",
    "vendor:types": "tsc -p src/components/tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir src/components"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@base-ui/utils": "^0.5.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.13.3",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@allonfire/config": "workspace:*",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
