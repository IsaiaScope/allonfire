# Copy to .env (Local) and .env.production (Production): same keys, in
# alphabetical order. Read by `image:setup` and `test-bucket`; Vitest sets its
# own.
STORAGE_ACCESS_KEY="allonfire"
# STORAGE_BUCKET="image"
STORAGE_ENDPOINT="http://localhost:9000"
# The Export route's own limit (30 a minute per User), on top of the global one.
STORAGE_EXPORT_RATE_LIMIT_KEY_PREFIX="export:"
STORAGE_EXPORT_RATE_LIMIT_MAX="30"
STORAGE_EXPORT_RATE_LIMIT_WINDOW_MS="60000"
STORAGE_IMAGE_SERVER_KEY="5ac692d6a2b19f10fdcdc2f2dd03efdf413a4108bf93d08508e9c4c6656d95f1"
STORAGE_IMAGE_SERVER_SALT="b8d9db70864d2cf60e0b5d06d04b8cb5"
STORAGE_IMAGE_SERVER_URL="http://localhost:9010/image"
STORAGE_SECRET_KEY="allonfire"
