# Local MinIO as `pnpm docker:up` starts it; read by `image:setup` and
# `test-bucket`. Copy to `.env`. Vitest sets the same values itself.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="allonfire"
STORAGE_SECRET_KEY="allonfire"
# The image server (imgproxy) every stored picture is served by, through links
# the API signs; the key and salt are the Local stack's throwaway hex.
STORAGE_IMAGE_SERVER_URL="http://localhost:9010"
STORAGE_IMAGE_SERVER_KEY="5ac692d6a2b19f10fdcdc2f2dd03efdf413a4108bf93d08508e9c4c6656d95f1"
STORAGE_IMAGE_SERVER_SALT="b8d9db70864d2cf60e0b5d06d04b8cb5"
