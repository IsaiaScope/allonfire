{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/render.ts",
    "src/render-overlays.ts",
    "src/spec.ts",
    "src/**/*.test.ts",
    "src/prototype/**/*.ts",
    "src/tutorial-kit/lib/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "src/prototype/export-mockups.ts"]
}
