{
  "name": "@allonfire/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./services": "./src/services/index.ts",
    "./generated/prisma": "./generated/prisma/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env src/seed.ts",
    "db:seed-quiz": "tsx --env-file=.env src/seed-quiz.ts",
    "db:export-topics": "tsx --env-file=.env src/export-topics.ts",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@t3-oss/env-core": "^0.13.10",
    "better-auth": "^1.2.0",
    "prisma": "^6.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.0"
  }
}
