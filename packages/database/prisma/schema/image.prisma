// Images, each placed in one or more Apps (ADR 0013, ADR 0020), public or
// private as a whole (ADR 0027).

/// Who sees an Image, wherever it is placed (ADR 0027).
enum ImageAccess {
  /// Anyone, signed in or not.
  PUBLIC  @map("public")
  /// Only those who enter at least one of its Apps.
  PRIVATE @map("private")

  @@schema("image")
}

model Image {
  id          String     @id @default(cuid(2))
  /// `<uuid>.avif` in the image bucket; carries no App, so placing it is an ImageApp row.
  key         String     @unique
  width       Int
  height      Int
  bytes       Int
  blurDataUrl String
  /// One alt per Language, `{ en, it }`; shape checked by imageAltSchema.
  alt         Json
  /// Public or private in every App it is in; private until made public.
  access      ImageAccess @default(PRIVATE)
  uploadedBy  String?
  user        User?      @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  /// Every App the Image is in; never empty (the API refuses an empty list,
  /// and removing the last placement deletes the Image).
  apps        ImageApp[]
  createdAt   DateTime   @default(now())

  @@index([createdAt, id])
  @@schema("image")
}

/// One App an Image is placed in (ADR 0020).
model ImageApp {
  imageId   String
  app       App
  createdAt DateTime @default(now())
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([imageId, app])
  @@index([app, imageId])
  @@schema("image")
}
