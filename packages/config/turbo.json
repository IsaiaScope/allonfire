{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // local/tests/*.test.ts read these: a change to one re-runs it.
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/.github/workflows/deploy.yml",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/docker/.env.example",
        "$TURBO_ROOT$/docker/Dockerfile",
        "$TURBO_ROOT$/docker/docker-compose.dev.yml",
        "$TURBO_ROOT$/docker/docker-compose.prod.yml",
        "$TURBO_ROOT$/apps/*/.env.example",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/src/environment/*.ts",
        "$TURBO_ROOT$/packages/*/.env.example",
        "$TURBO_ROOT$/packages/*/src/environment/*.ts"
      ]
    }
  }
}
