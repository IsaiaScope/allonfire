# Copy to /opt/backups/.env on the VPS (Production, mirrored in .env.production)
# and fill in the values. Local's vps/.env, read by `workflows.sh --local`, holds
# the same keys with Local's values. Blocks by owner, keys in alphabetical
# order. Cron runs backup.sh on the host (/etc/cron.d/backup-schedule); the
# workflow service only receives the manifest and sends the Telegram message.

# Agent (Hermes)
BACKUP_AGENT_DIR=/home/your-user/your-agent
BACKUP_AGENT_VOLUME=your-agent-state-volume

# Age encryption
# The public key lives on the server (encrypting). The private key lives only
# in the password manager; restore-test.sh reads it from this path, and it is
# shredded after every drill.
BACKUP_AGE_PRIVATE_KEY_PATH=/opt/backups/.age-key.txt
BACKUP_AGE_PUBLIC_KEY=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Containers (grep against `docker ps --format`)
# Dokploy's PostgreSQL is shared: every database except Multica's lives in it.
BACKUP_DOKPLOY_PG_CONTAINER_PATTERN=dokploy-postgres
BACKUP_PG_CONTAINER_PATTERN=dokploy-postgres
BACKUP_STORAGE_CONTAINER_PATTERN=allonfire-.*-storage-
BACKUP_WORKFLOW_CONTAINER_PATTERN=n8n

# Hetzner Cloud (snapshots)
BACKUP_HCLOUD_TOKEN=your-hcloud-api-token
BACKUP_HETZNER_SERVER_ID=your-server-id

# Keep-alive
# The API's keep-alive, which the workflow service calls daily; workflows.sh
# fills it into services-keep-alive.json on import. Its token lives in the
# workflow service's "Keep-alive Token" credential, never here.
BACKUP_KEEP_ALIVE_URL=https://<api-host>/v1/services/keep-alive

# Notification (workflow service)
# backup.sh POSTs the manifest JSON here when it ends; empty skips the notice.
# The token must match the webhook node's header-auth credential (X-Backup-Token).
BACKUP_WEBHOOK_TOKEN=your-secret-token
BACKUP_WEBHOOK_URL=https://workflow.example.com/webhook/<backup-webhook-path>

# PostgreSQL
# pg_dumpall runs as the superuser, so it dumps every database.
BACKUP_DOKPLOY_PG_DATABASE=dokploy
BACKUP_DOKPLOY_PG_USER=dokploy
BACKUP_PG_USER=dokploy

# Retention
BACKUP_KEEP_SNAPSHOTS=4
BACKUP_LOCAL_RETENTION_DAYS=2

# S3
# AWS credentials are read from ~/.aws/credentials (`aws configure`).
BACKUP_S3_BUCKET=your-backup-bucket

# SSL certificates
BACKUP_ACME_JSON_PATH=/etc/dokploy/traefik/dynamic/acme.json

# Telegram
# The chat the workflow service sends backup and crash messages to;
# workflows.sh import fills it into the workflows. Local only: the bot tokens
# fill the credentials `workflows.sh --local import` writes; on the VPS they
# live in the workflow service, never in this file.
# BACKUP_TELEGRAM_ALLONFIRE_BOT_TOKEN=
# BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=your-chat-id
