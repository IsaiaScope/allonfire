{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "MINIO_ENDPOINT",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "MINIO_BUCKET",
    "REDIS_URL",
    "PORT",
    "LOG_LEVEL",
    "CORS_ORIGINS",
    "TRUSTED_PROXY_HOPS",
    "ENABLE_DOCS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ANALYZE", "NEXT_DIST_DIR", "MINIO_ENDPOINT", "MINIO_BUCKET"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check-types": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "i18n:check": {
      "inputs": ["src/features/i18n/translations/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "db:generate": {
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["transit"]
    },
    "//#test:ui": {
      "cache": false,
      "persistent": true
    }
  }
}
