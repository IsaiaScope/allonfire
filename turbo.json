{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "N8N_API_KEY"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "vitest.config.ts",
        "vitest.setup.ts",
        ".env*",
        "../../packages/database/prisma/schema.prisma"
      ],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "N8N_API_KEY",
        "ENCRYPTION_KEY"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    }
  }
}
