{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "MINIO_ENDPOINT",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "MINIO_BUCKET",
    "REDIS_URL",
    "PORT",
    "LOG_LEVEL",
    "CORS_ORIGINS",
    "TRUSTED_PROXY_HOPS",
    "ENABLE_DOCS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "i18n:check": {
      "inputs": ["src/i18n/messages/**"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "vitest.config.ts",
        "vitest.setup.ts",
        ".env*",
        "scripts/**",
        "changelog/**",
        "liquibase/**",
        "../../packages/database/prisma/schema/**",
        "../../packages/database/changelog/**"
      ],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL", "BETTER_AUTH_SECRET"]
    },
    "db:generate": {
      "cache": false
    }
  }
}
