{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "futureFlags": { "affectedUsingTaskInputs": true },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "STORAGE_ENDPOINT",
    "STORAGE_ACCESS_KEY",
    "STORAGE_SECRET_KEY",
    "STORAGE_BUCKET",
    "API_REDIS_URL",
    "PORT",
    "API_LOG_LEVEL",
    "API_CORS_ORIGINS",
    "API_TRUSTED_PROXY_HOPS",
    "API_ENABLE_DOCS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ANALYZE",
        "NEXT_DIST_DIR",
        "STORAGE_ENDPOINT",
        "STORAGE_BUCKET",
        "NEXT_PUBLIC_API_URL",
        "BACK_OFFICE_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.md"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "persistent": true
    },
    "check-types": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "i18n:check": {
      "inputs": ["src/**/i18n/translations/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test:browser": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "db:generate": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "passThroughEnv": ["CI", "CONFIG_E2E_STAMP"]
    },
    "//#test:ui": {
      "cache": false,
      "persistent": true
    }
  }
}
