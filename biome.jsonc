{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/vitest",
    // Project + types domains: module graph and type inference (cycles,
    // undeclared deps, deprecated imports). Scans the whole repo on every run.
    "ultracite/biome/type-aware"
  ],
  "vcs": {
    // `biome check --changed` diffs against this; the repo's base is dev.
    "defaultBranch": "dev"
  },
  "files": {
    // Written only by the shadcn CLI (ADR 0010): formatting it would turn every
    // CLI update into a diff against our own edits.
    "includes": ["!packages/shadcn/src"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 100, "skipBlankLines": true }
        },
        "noImplicitCoercions": "error",
        "useMaxParams": "error"
      },
      "correctness": {
        // Bundler resolution: TS imports carry no extension.
        "useImportExtensions": "off",
        // False positives on pnpm-linked packages resolved through `exports`
        // (hono/*, pino). tsc already fails on a bad import.
        "noUnresolvedImports": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "style": {
        "noExcessiveLinesPerFile": "error",
        // Env is read once, in the validated env module of each package.
        "noProcessEnv": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        }
      },
      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": ["error"] } },
        "noUndeclaredEnvVars": "error"
      }
    }
  },
  "overrides": [
    {
      // ponytail: Laura's React components carry lint debt from before the
      // rules were tightened; the linter skips them until the Laura redesign.
      // Formatting still applies.
      "includes": ["apps/laura/**"],
      "linter": { "enabled": false }
    },
    {
      // vitest runs with `globals: true` (packages/config/tests/vitest.config.ts).
      "includes": ["**/*.test.ts", "**/*.test-d.ts", "**/tests/**"],
      "javascript": {
        "globals": [
          "afterAll",
          "afterEach",
          "beforeAll",
          "beforeEach",
          "describe",
          "expect",
          "expectTypeOf",
          "it",
          "test",
          "vi"
        ]
      }
    },
    {
      // The places allowed to touch process.env, print, and run long.
      "includes": [
        "**/env.ts",
        "**/environment.ts",
        "**/seed*.ts",
        // Seed data: long lists by nature.
        "**/mock/**",
        "**/scripts/**",
        "**/*.config.ts",
        "**/vitest.setup.ts",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off",
            "noProcessEnv": "off"
          },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      // Apps and packages reach the Design system through AOF components only
      // (ADR 0010). `packages/ui` is the one place that wraps shadcn.
      "includes": ["apps/**", "packages/**", "!packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@allonfire/shadcn", "@allonfire/shadcn/**"],
                    "message": "Import the AOF component from @allonfire/ui instead; add one there if it does not exist yet."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
