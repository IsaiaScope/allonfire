# Copy to docker/.env (Local) and docker/.env.production (Production, Dokploy's
# AllOnFire env): same keys. Compose reads the .env beside the compose file.
# Blocks by owner, keys in alphabetical order; Production-only keys commented.

# API (API_TRUSTED_PROXY_HOPS unset: 1, Traefik)
# API_HOST=
# API_TRUSTED_PROXY_HOPS=

# Auth
# AUTH_COOKIE_DOMAIN=".isaiariva.com"
# AUTH_SECRET=

# Back Office
# BACK_OFFICE_HOST=
# BACK_OFFICE_URL=

# CDN: the public delivery address (pictures under /image)
# CDN_HOST=

# Database (POSTGRES_*: Local's database service, names from the Postgres image)
# DATABASE_URL=
POSTGRES_DB="allonfire"
POSTGRES_PASSWORD="allonfire"
POSTGRES_USER="allonfire"

# Deploy: GitHub prod, never Dokploy. DOKPLOY_URL is
# https://<user>:<password>@panel.isaiariva.com.
# DOKPLOY_API_KEY=
# DOKPLOY_COMPOSE_ID=
# DOKPLOY_URL=

# Storage (the access pair is the root login, the console's too)
STORAGE_ACCESS_KEY="allonfire"
# STORAGE_IMAGE_SERVER_KEY=
# STORAGE_IMAGE_SERVER_SALT=
STORAGE_SECRET_KEY="allonfire"

# Telemetry (the header is the ingest user's Basic auth, Authorization=Basic%20<base64>)
# TELEMETRY_HEADERS=
# TELEMETRY_ROOT_EMAIL=
# TELEMETRY_ROOT_PASSWORD=
# TELEMETRY_STORAGE_ACCESS_KEY=
# TELEMETRY_STORAGE_SECRET_KEY=
